  <maintainer email="kweontj0701@naver.com">ktj</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>numpy</exec_depend>
