Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground (100 mm)
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 165; 172; 184
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Leader + two-level shelf (display only)
      Enabled: true
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /shelf_preview/robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Links:
        All Links Enabled: true
        Expand Tree: false
    - Class: rviz_default_plugins/TF
      Name: Floor frames
      Enabled: false
  Global Options:
    Background Color: 220; 226; 235
    Fixed Frame: base_footprint
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.25
      Focal Point:
        X: 0.20
        Y: 0
        Z: 0.17
      Pitch: 0.40
      Yaw: 2.25
    Saved: []
Window Geometry:
  Width: 1600
  Height: 1000
