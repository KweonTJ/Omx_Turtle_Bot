<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="orbbec_astra"
               params="parent_link
                       xyz:='0.0 0.0 0.0'
                       rpy:='0.0 0.0 0.0'
                       robot_namespace:=''
                       component_name:=''
                       use_tf_prefix:=True
                       publish_internal_frames:=True
                       leader_visuals:=False">

    <xacro:if value="${component_name == ''}">
      <xacro:property name="component_name" value="camera" />
    </xacro:if>

    <xacro:property name="robot_namespace_slash" value="${robot_namespace + '/' if robot_namespace != '' else ''}" />
    <xacro:property name="tf_prefix" value="${robot_namespace_slash if use_tf_prefix in ['True', True] else ''}" />
    <xacro:property name="component_name_underscore" value="${component_name + '_' if component_name != '' else ''}" />
    <xacro:property name="component_name_slash" value="${component_name + '/' if component_name != '' else ''}" />
    <xacro:property
      name="publish_internal_frames_enabled"
      value="${publish_internal_frames in ['True', 'true', True]}" />

    <joint name="${parent_link.rstrip('_link')}_to_${component_name_underscore}joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent_link}" />
      <child link="${component_name_underscore}link" />
    </joint>

    <link name="${component_name_underscore}link" />

    <joint name="${parent_link.rstrip('_link')}_to_${component_name_underscore}astra_visual_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent_link}" />
      <child link="${component_name_underscore}astra_visual_frame" />
    </joint>

    <link name="${component_name_underscore}astra_visual_frame">
      <xacro:if value="${leader_visuals}">
        <xacro:leader_depth_camera_visuals/>
      </xacro:if>
      <xacro:unless value="${leader_visuals}">
      <!-- Astra mesh is not present in this repository, so the model uses primitive visuals. -->
      <visual>
        <origin xyz="${0.0225-0.04/2.0} 0.0 ${0.019+0.03/2.0}" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.04 0.165 0.03" />
        </geometry>
        <material name="LightGrey">
          <color rgba="0.6 0.6 0.6 1.0" />
        </material>
      </visual>
      <visual>
        <origin xyz="${0.0235-0.06/2.0} 0.0 ${0.019/2.0}" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.06 0.06 0.019" />
        </geometry>
        <material name="LightGrey">
          <color rgba="0.6 0.6 0.6 1.0" />
        </material>
      </visual>

      </xacro:unless>
      <!-- Move collision with the leader display housing, not the sensor TF. -->
      <xacro:property name="camera_geometry_scale" value="${leader_camera_scale if leader_visuals else 1.0}"/>
      <xacro:property name="camera_body_x" value="${leader_camera_body_x if leader_visuals else 0.0225-0.04/2.0}"/>
      <xacro:property name="camera_body_z" value="${leader_camera_body_z if leader_visuals else 0.019+0.03/2.0}"/>
      <xacro:property name="camera_pedestal_x" value="${leader_camera_pedestal_x if leader_visuals else 0.0235-0.06/2.0}"/>
      <xacro:property name="camera_pedestal_bottom" value="${leader_camera_pedestal_bottom if leader_visuals else 0.0}"/>
      <xacro:property name="camera_pedestal_height" value="${leader_camera_pedestal_height if leader_visuals else 0.019}"/>
      <!-- camera module collision -->
      <collision>
        <origin xyz="${camera_body_x} 0.0 ${camera_body_z}" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="${0.04*camera_geometry_scale} ${0.165*camera_geometry_scale} ${0.03*camera_geometry_scale}" />
        </geometry>
      </collision>

      <!-- mounting base model collision -->
      <collision>
        <origin xyz="${camera_pedestal_x} 0.0 ${camera_pedestal_bottom+camera_pedestal_height/2.0}" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="${0.06*camera_geometry_scale} ${0.06*camera_geometry_scale} ${camera_pedestal_height}" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.0 0.0 ${0.019+0.01}" rpy="0.0 0.0 0.0" />
        <mass value="0.300" />
        <inertia ixx="0.00073916" ixy="0.0"        ixz="0.0"
                                  iyy="0.00015435" iyz="0.0"
                                                   izz="0.00077395" />
      </inertial>
    </link>

    <xacro:if value="${publish_internal_frames_enabled}">
      <joint name="${component_name_underscore}to_${component_name_underscore}color_joint" type="fixed">
        <origin xyz="-0.002 0.0125 0.03325" rpy="-0.003 0.0 -0.003" />
        <parent link="${component_name_underscore}link" />
        <child link="${component_name_underscore}color_frame" />
      </joint>

      <link name="${component_name_underscore}depth_frame" />

      <joint name="${component_name_underscore}to_${component_name_underscore}depth_joint" type="fixed">
        <origin xyz="0.0 0.0 0.03325" rpy="0.0 0.0 0.0" />
        <parent link="${component_name_underscore}link" />
        <child link="${component_name_underscore}depth_frame" />
      </joint>

      <link name="${component_name_underscore}color_frame" />

      <joint name="${component_name_underscore}color_to_${component_name_underscore}color_optical_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="${-pi/2} 0.0 ${-pi/2}" />
        <parent link="${component_name_underscore}color_frame" />
        <child link="${component_name_underscore}color_optical_frame" />
      </joint>

      <link name="${component_name_underscore}depth_optical_frame" />

      <joint name="${component_name_underscore}depth_to_${component_name_underscore}depth_optical_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="${-pi/2} 0.0 ${-pi/2}" />
        <parent link="${component_name_underscore}depth_frame" />
        <child link="${component_name_underscore}depth_optical_frame" />
      </joint>

      <link name="${component_name_underscore}color_optical_frame" />
    </xacro:if>

    <!-- GAZEBO -->
    <!-- https://github.com/orbbec/OrbbecSDK_ROS2#all-available-topics -->
    <xacro:include filename="$(find turtlebot3_manipulation_description)/xacro/gz_sensor.urdf.xacro" ns="gz_sensor" />

    <xacro:gz_sensor.camera
      reference="${component_name_underscore}link"
      name="${robot_namespace_slash}${component_name_underscore}camera_color"
      topic="${robot_namespace_slash}${component_name_slash}color/image_raw"
      frame_id="${tf_prefix}${component_name_underscore}color_optical_frame"
      frequency="30"
      width="640"
      height="480"
      fov="${60.0/180.0*pi}" />

    <xacro:gz_sensor.depth_camera
      reference="${component_name_underscore}link"
      name="${robot_namespace_slash}${component_name_underscore}camera_depth"
      topic="${robot_namespace_slash}${component_name_slash}depth/image_raw"
      frame_id="${tf_prefix}${component_name_underscore}depth_optical_frame"
      frequency="30"
      width="640"
      height="480"
      fov="${60.0/180.0*pi}"
      min_dist="0.12"
      max_dist="8.0"
      stddev_error="0.005" />

  </xacro:macro>
</robot>
